{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/track-session.py start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/track-session.py end"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(curl -s *)",
      "Bash(curl -sL *)",
      "Bash(git fetch *)",
      "Bash(dig *)",
      "Bash(textutil -convert txt -stdout *)"
    ]
  }
}
